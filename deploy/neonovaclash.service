# NeoNovaClash 的 systemd 服务单元（宝塔 / 普通 Debian·Ubuntu 通用）
#
# 安装：
#   cp deploy/neonovaclash.service /etc/systemd/system/neonovaclash.service
#   install -m 644 deploy/logrotate/neonovaclash /etc/logrotate.d/neonovaclash
#   systemctl daemon-reload && systemctl enable --now neonovaclash
#
# 说明：
# - 用 run.py 启动，监听地址与端口由下面的 NC_HOST / NC_PORT 决定
#   （uvicorn 命令行不读这两个环境变量，所以不要直接写 uvicorn backend.web.app:app）
# - 应用只监听 127.0.0.1:8010，由 nginx 反向代理对外提供（见 deploy/nginx.neonovaclash.conf）
# - 用 www 用户运行（宝塔的默认站点用户），目录属主也要是 www
# - 房间状态在内存里，所以固定单进程：不要加 --workers
# - 每个 Environment 都会覆盖代码里的默认值，改这里之前先看一眼 backend/config.py：
#   NC_PREPARE_TIMEOUT 必须是 90（与 docs/规则设定.md 的"备战限时 90 秒"一致）

[Unit]
Description=NeoNovaClash 星陨竞技场（FastAPI + WebSocket）
After=network.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/neonovaclash
Environment=NC_HOST=127.0.0.1
Environment=NC_PORT=8010
Environment=NC_PREPARE_TIMEOUT=90
Environment=NC_RECONNECT_GRACE=90
Environment=NC_ROOM_TTL=1800
Environment=NC_MAX_ROOMS=200
Environment=NC_LOG_LEVEL=info
ExecStart=/www/wwwroot/neonovaclash/venv/bin/python run.py
Restart=always
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes

# 应用日志落盘：日志走 stderr，这里显式接进文件，否则服务一重启日志就没了（journald 未持久化时更是什么都查不到）。
# 轮转由 deploy/logrotate/neonovaclash 负责（每天切、留 14 天、压缩）。
StandardOutput=append:/www/wwwlogs/neonovaclash.app.log
StandardError=append:/www/wwwlogs/neonovaclash.app.log

[Install]
WantedBy=multi-user.target
